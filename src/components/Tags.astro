---
import type { HTMLAttributes } from 'astro/types';
import { tagHashColor } from '../lib/tags';

type Props = HTMLAttributes<'ul'> & {
  tags?: string[];
};

const { class: className, tags = [], ...props } = Astro.props as Props;

const sortedTags = [...tags].sort();
---

{/* Renders nothing when empty so callers can always pass data-vt-* / class. */}
{sortedTags.length > 0 && (
  <ul class:list={['flex flex-wrap gap-2 text-xs', className]} {...props}>
    {sortedTags.map((tag: string) => (
      <li>
        <a
          href={`${import.meta.env.BASE_URL}tags/${encodeURIComponent(tag)}/`}
          class="text-blue-800 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-400 no-underline hover:underline"
        >
          <span class={tagHashColor(tag)}>#</span>{tag}
        </a>
      </li>
    ))}
  </ul>
)}
