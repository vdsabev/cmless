---
---

<button
	type="button"
	id="theme-toggle"
	class="inline-flex shrink-0 items-center justify-center size-[var(--pf-input-height)] rounded-lg border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-100 bg-transparent cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 dark:focus-visible:outline-blue-400"
	aria-label="Use dark theme"
>
	<svg
		data-theme-icon="system"
		class="size-5"
		viewBox="0 0 24 24"
		aria-hidden="true"
	>
		<circle
			cx="12"
			cy="12"
			r="6"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
		/>
		<path d="M12 6a6 6 0 0 0 0 12Z" fill="currentColor" />
	</svg>
	<svg
		data-theme-icon="dark"
		class="size-5"
		viewBox="0 0 24 24"
		aria-hidden="true"
	>
		<defs>
			<mask id="theme-moon-cut" maskUnits="userSpaceOnUse">
				<circle cx="12" cy="12" r="7" fill="white" />
				<circle cx="8" cy="8.5" r="6.7" fill="black" />
			</mask>
		</defs>
		<circle cx="12" cy="12" r="7" fill="currentColor" mask="url(#theme-moon-cut)" />
		<path
			fill="currentColor"
			d="M5.35 1.25 6.22 5.34 10.25 6.15 6.22 6.96 5.35 11.05 4.48 6.96 0.45 6.15 4.48 5.34Z"
		/>
	</svg>
	<svg
		data-theme-icon="light"
		class="size-5"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="6" />
		<path d="M12 1.5v2.2M12 20.3v2.2M22.5 12h-2.2M3.7 12H1.5M19.42 4.58l-1.56 1.56M6.14 17.86l-1.56 1.56M19.42 19.42l-1.56-1.56M6.14 6.14 4.58 4.58" />
	</svg>
</button>
