---
/**
 * Horizontally scrolling strip of link cards (issues labeled `link`), one per section.
 *
 * - Scroll snap, one card per snap point; swipe / trackpad / keyboard (Tab) all work.
 * - Edge fades come from a scroll-driven animation (`animation-timeline: scroll()`):
 *   the left fade grows in once you scroll away from the start, the right fade
 *   shrinks out at the end, and neither shows when nothing overflows (the
 *   timeline is inactive then). Browsers without support just show no fade.
 * - Prev/next buttons page by the visible width; hidden when nothing overflows
 *   and disabled at either end. Without JS they stay hidden.
 * - Cards open in a new tab unless the link sets `newTab: false`; an ↗ marks those.
 */
import CoverImage from './CoverImage.astro';

import type { Link } from '../lib/links';

const { links, title, id } = Astro.props as { links: Link[]; title: string; id: string };
const headingId = `${id}-heading`;
---

<section class="mb-10" aria-labelledby={headingId} data-link-strip>
	<div class="flex items-center justify-between gap-4 mb-3">
		<h2 id={headingId} class="text-xl font-semibold">{title}</h2>
		<div class="flex gap-2" data-link-strip-buttons hidden>
			<button
				type="button"
				class="link-strip-button"
				data-link-strip-prev
				aria-label={`Scroll ${title.toLowerCase()} left`}
			>
				<svg class="size-5" viewBox="0 0 24 24" aria-hidden="true"
					><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
					></path></svg
				>
			</button>
			<button
				type="button"
				class="link-strip-button"
				data-link-strip-next
				aria-label={`Scroll ${title.toLowerCase()} right`}
			>
				<svg class="size-5" viewBox="0 0 24 24" aria-hidden="true"
					><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
					></path></svg
				>
			</button>
		</div>
	</div>

	<ul class="link-strip flex gap-4 overflow-x-auto" data-link-strip-track>
		{
			links.map((link) => (
				<li class="group relative shrink-0 w-40 sm:w-48 snap-start">
					<a
						href={link.url}
						target={link.newTab ? '_blank' : undefined}
						rel={link.newTab ? 'noopener' : undefined}
						class="absolute inset-0 z-10 corner-squircle rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 dark:focus-visible:outline-blue-400"
						aria-label={link.newTab ? `${link.title} (opens in new tab)` : link.title}
					/>
					{link.image ? (
						<CoverImage
							class="w-full aspect-[1200/630] object-cover corner-squircle rounded-xl bg-slate-100 dark:bg-slate-800"
							src={link.image}
							alt={link.imageAlt || link.title}
						/>
					) : (
						<div
							class="w-full aspect-[1200/630] corner-squircle rounded-xl bg-gradient-to-br from-blue-100 to-slate-200 dark:from-blue-950 dark:to-slate-800 flex items-center justify-center text-3xl font-semibold text-slate-500 dark:text-slate-400"
							aria-hidden="true"
						>
							{link.title.trim().charAt(0).toUpperCase()}
						</div>
					)}
					<h3 class="mt-2 font-semibold leading-tight group-hover:underline">
						{link.title}
						{link.newTab && (
							<svg class="inline-block size-3.5 ml-0.5 align-baseline text-slate-400 dark:text-slate-500" viewBox="0 0 24 24" aria-hidden="true"
								><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
								></path></svg
							>
						)}
					</h3>
					{link.description && (
						<p class="mt-1 text-sm text-slate-500 dark:text-slate-400 leading-normal line-clamp-2">
							{link.description}
						</p>
					)}
				</li>
			))
		}
	</ul>
</section>

<style>
	@property --link-strip-fade-start {
		syntax: '<length>';
		inherits: false;
		initial-value: 0px;
	}
	@property --link-strip-fade-end {
		syntax: '<length>';
		inherits: false;
		initial-value: 0px;
	}

	.link-strip {
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		overscroll-behavior-x: contain;
		/* Room for focus rings, which overflow clips otherwise. */
		padding-block: 4px;
		margin-block: -4px;
		mask-image: linear-gradient(
			to right,
			transparent,
			#000 var(--link-strip-fade-start),
			#000 calc(100% - var(--link-strip-fade-end)),
			transparent
		);
	}
	.link-strip::-webkit-scrollbar {
		display: none;
	}

	@supports (animation-timeline: scroll()) {
		.link-strip {
			animation: link-strip-fade linear both;
		}
		/*
		 * Separate rule on purpose: the CSS minifier folds a same-rule
		 * animation-timeline into the `animation` shorthand, which Chrome rejects.
		 */
		ul.link-strip {
			animation-timeline: scroll(self inline);
		}
	}

	/* Fade grows in over the first ~5% of scroll and out over the last ~5%. */
	@keyframes link-strip-fade {
		0% {
			--link-strip-fade-start: 0px;
			--link-strip-fade-end: 3rem;
		}
		5% {
			--link-strip-fade-start: 3rem;
		}
		95% {
			--link-strip-fade-end: 3rem;
		}
		100% {
			--link-strip-fade-start: 3rem;
			--link-strip-fade-end: 0px;
		}
	}

	.link-strip-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--pf-input-height);
		height: var(--pf-input-height);
		border-radius: 0.5rem;
		border: 1px solid var(--pf-border);
		color: var(--pf-text-secondary);
		background: transparent;
		cursor: pointer;
	}
	.link-strip-button:hover:not(:disabled) {
		color: var(--pf-text);
	}
	.link-strip-button:disabled {
		opacity: 0.4;
		cursor: default;
	}
	.link-strip-button:focus-visible {
		outline: 2px solid var(--pf-outline-focus);
		outline-offset: 2px;
	}
</style>

<script>
	for (const section of document.querySelectorAll<HTMLElement>('[data-link-strip]')) {
		const track = section.querySelector<HTMLElement>('[data-link-strip-track]');
		const buttons = section.querySelector<HTMLElement>('[data-link-strip-buttons]');
		const prev = section.querySelector<HTMLButtonElement>('[data-link-strip-prev]');
		const next = section.querySelector<HTMLButtonElement>('[data-link-strip-next]');
		if (!track || !buttons || !prev || !next) continue;

		const update = () => {
			const max = track.scrollWidth - track.clientWidth;
			buttons.hidden = max <= 1;
			prev.disabled = track.scrollLeft <= 1;
			next.disabled = track.scrollLeft >= max - 1;
		};

		const page = (direction: 1 | -1) => {
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			// Scroll by the visible width minus one card's peek so nothing is skipped.
			track.scrollBy({ left: direction * track.clientWidth * 0.8, behavior: reduce ? 'auto' : 'smooth' });
		};

		prev.addEventListener('click', () => page(-1));
		next.addEventListener('click', () => page(1));
		track.addEventListener('scroll', update, { passive: true });
		new ResizeObserver(update).observe(track);
		update();
	}
</script>
