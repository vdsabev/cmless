---
import Layout from '../layouts/Layout.astro';
import CoverImage from '../components/CoverImage.astro';
import PostMeta from '../components/PostMeta.astro';
import Tags from '../components/Tags.astro';
import SeriesNavList from '../components/SeriesNavList.astro';
import SeriesNavPager from '../components/SeriesNavPager.astro';
import { pathToSlug } from '../lib/slug';
import { getReadingTimeInMinutes } from '../lib/reading-time';
import { abs, getAllContent, getSeriesPosts, postMdPath } from '../lib/content';
import { blogPostingJsonLd, webPageJsonLd } from '../lib/jsonld';
import site from '../generated/site.json';

export function getStaticPaths() {
	const modules = import.meta.glob('../content/blog/*.md', { eager: true });
	return Object.entries(modules).map(([filePath, mod]) => {
		const slug = pathToSlug(filePath);
		const frontmatter = (mod as any).frontmatter || {};
		return {
			params: { slug },
			props: { mod, frontmatter, slug },
		};
	});
}

const { mod, frontmatter, slug } = Astro.props;
const { Content } = mod as any;

// Normalized fields (status default, tags, series, …) come from lib/content.ts.
const entry = getAllContent().find((e) => e.slug === slug)!;
const { title, date, image, series, tags, body } = entry;
const isPage = entry.isNav;
const description = entry.description || undefined;
const imageAlt = entry.imageAlt || title;
/** In-article hero for real covers only — not the repo social-preview fallback (still used for OG via Layout). */
const socialPreviewUrl = ((site as { socialPreviewUrl?: string }).socialPreviewUrl || '').trim();
const showCover = !!image && image.trim() !== socialPreviewUrl;

const author = frontmatter.author;
const authorUrl = frontmatter.authorUrl;
const authorAvatar = frontmatter.authorAvatar;
const readingTime = !isPage && body ? getReadingTimeInMinutes(body) : null;

const markdownHref = abs(postMdPath(slug), Astro.site);

const isPublished = entry.status === 'published';

const jsonLd = !isPublished
	? undefined
	: isPage
		? webPageJsonLd({
				site: Astro.site,
				slug,
				title,
				description,
				date,
				image,
				author,
				authorUrl,
				authorAvatar,
			})
		: blogPostingJsonLd({
				site: Astro.site,
				slug,
				title,
				description,
				date,
				image,
				imageAlt,
				tags,
				author,
				authorUrl,
				authorAvatar,
				siteTitle: site.siteTitle,
			});

// Series peers: same `series` value, ordered by date ascending
const seriesPosts = getSeriesPosts(series).map(({ slug, title, date }) => ({ slug, title, date }));
const seriesIndex = seriesPosts.findIndex((post) => post.slug === slug);
const seriesPrev = seriesIndex > 0 ? seriesPosts[seriesIndex - 1] : null;
const seriesNext = seriesIndex >= 0 ? seriesPosts[seriesIndex + 1] ?? null : null;

---

<Layout
	title={title}
	description={description}
	image={image}
	siteTitle={site.siteTitle}
	markdownHref={markdownHref}
	jsonLd={jsonLd}
	ogType={isPage ? 'website' : 'article'}
	publishedTime={date}
	tags={tags}
>
	{isPage ? (
		<div class="prose dark:prose-invert max-w-none" data-pagefind-body>
			{description && (
				<span class="sr-only" data-pagefind-meta="description">{description}</span>
			)}
			{tags.map((tag: string) => (
				<span class="sr-only" data-pagefind-filter="tag">{tag}</span>
			))}
			<Content />
		</div>
	) : (
		<article>
			<div data-pagefind-body>
				<hgroup>
					<h1 class="vt-post-title text-3xl" data-pagefind-meta="title">{title}</h1>
					<div class="mt-1" data-pagefind-ignore>
						<PostMeta
							class="vt-post-meta"
							name={author}
							url={authorUrl}
							avatar={authorAvatar}
							date={date}
							readingTime={readingTime}
							size="md"
						/>
					</div>
					{description && (
						<p
							class="vt-post-description mt-1 text-slate-500 dark:text-slate-400"
							data-pagefind-meta="description"
						>
							{description}
						</p>
					)}
				</hgroup>

				{tags.map((tag: string) => (
					<span class="sr-only" data-pagefind-filter="tag">{tag}</span>
				))}
				<Tags class="vt-post-tags mt-2 mb-4" tags={tags} />

				{showCover && image && (
					<CoverImage
						class="vt-post-image mt-0 mb-4 w-full aspect-[1200/630] object-cover corner-squircle rounded-xl"
						src={image}
						alt={imageAlt}
						priority
					/>
				)}

				{series && (
					<SeriesNavList name={series} posts={seriesPosts} currentSlug={slug} data-pagefind-ignore />
				)}

				<div class="prose dark:prose-invert max-w-none">
					<Content />
				</div>
			</div>

			{series && (
				<SeriesNavPager name={series} prev={seriesPrev} next={seriesNext} data-pagefind-ignore />
			)}
		</article>
	)}
</Layout>
