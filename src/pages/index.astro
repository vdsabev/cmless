---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { abs, getPublishedPosts, indexMdPath } from '../lib/content';
import { blogJsonLd } from '../lib/jsonld';
import { getReadingTimeInMinutes } from '../lib/reading-time';
import site from '../generated/site.json';

const publishedPosts = getPublishedPosts().map((post) => ({
	slug: post.slug,
	title: post.title,
	date: post.date,
	readingTime: post.body ? getReadingTimeInMinutes(post.body) : null,
	description: post.description,
	image: post.image,
	imageAlt: post.imageAlt,
	tags: post.tags,
}));

// Prioritize the first card that has a cover (LCP candidate on the index).
const firstPostWithImage = publishedPosts.find((post) => post.image);

const markdownHref = abs(indexMdPath(), Astro.site);
const owner = (site as { owner?: { login?: string; avatarUrl?: string } }).owner;
const jsonLd = blogJsonLd({
	site: Astro.site,
	siteTitle: site.siteTitle,
	description: site.siteDescription || undefined,
	image: (site as { socialPreviewUrl?: string }).socialPreviewUrl || undefined,
	ownerLogin: owner?.login,
	ownerAvatar: owner?.avatarUrl,
});
---

<Layout title="Posts" siteTitle={site.siteTitle} description={site.siteDescription || undefined} markdownHref={markdownHref} jsonLd={jsonLd}>
	{
		publishedPosts.length === 0 ? (
			<p>No published posts yet. Create a GitHub Issue and apply the <code>status: published</code> label.</p>
		) : (
			<ul class="flex flex-col gap-8">
				{
					publishedPosts.map((post) => (
						<PostCard
							slug={post.slug}
							title={post.title}
							date={post.date}
							readingTime={post.readingTime}
							description={post.description}
							image={post.image}
							imageAlt={post.imageAlt}
							tags={post.tags}
							priority={post === firstPostWithImage}
						/>
					))
				}
			</ul>
		)
	}
</Layout>
