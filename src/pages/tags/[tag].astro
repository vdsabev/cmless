---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { abs, getTagsMap, tagMdPath } from '../../lib/content';
import { getReadingTimeInMinutes } from '../../lib/reading-time';
import { tagHashColor } from '../../lib/tags';
import site from '../../generated/site.json';

type TagPost = {
	slug: string;
	title: string;
	date: string;
	readingTime: number | null;
	description?: string;
	image?: string;
	imageAlt?: string;
	tags: string[];
};

export function getStaticPaths() {
	const tagsMap = getTagsMap();
	return [...tagsMap.entries()].map(([tag, entries]) => ({
		params: { tag },
		props: {
			tag,
			posts: entries.map((post) => ({
				slug: post.slug,
				title: post.title,
				date: post.date,
				readingTime: post.body ? getReadingTimeInMinutes(post.body) : null,
				description: post.description,
				image: post.image,
				imageAlt: post.imageAlt,
				tags: post.tags,
			})) satisfies TagPost[],
		},
	}));
}

const { tag, posts } = Astro.props as { tag: string; posts: TagPost[] };

// Prioritize the first card that has a cover (LCP candidate on tag pages).
const firstImagePost = posts.find((post) => post.image);

const markdownHref = abs(tagMdPath(tag), Astro.site);
---

<Layout title={`#${tag}`} siteTitle={site.siteTitle} description={`Posts tagged ${tag}.`} markdownHref={markdownHref}>
	<h1 class="text-2xl font-semibold mb-8">
		<span class={tagHashColor(tag)}>#</span>{tag}
	</h1>

	{
		posts.length === 0 ? (
			<p>No published posts with this tag.</p>
		) : (
			<ul class="flex flex-col gap-8">
				{posts.map((post) => (
					<PostCard
						slug={post.slug}
						title={post.title}
						date={post.date}
						readingTime={post.readingTime}
						description={post.description}
						image={post.image}
						imageAlt={post.imageAlt}
						tags={post.tags}
						priority={post === firstImagePost}
					/>
				))}
			</ul>
		)
	}
</Layout>
