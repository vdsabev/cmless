---
import '../styles/global.css';
import NavLink from '../components/NavLink.astro';
import SocialIcon from '../components/SocialIcon.astro';
import site from '../generated/site.json';
import nav from '../generated/navigation.json';
import { serializeJsonLd } from '../lib/jsonld';

interface NavItem {
	title: string;
	slug: string;
	navigationIndex: number;
}

interface Props {
	title?: string;
	description?: string;
	image?: string;
	siteTitle?: string;
	/** Absolute or site-root URL of the static Markdown twin (`/<slug>.md`). */
	markdownHref?: string;
	/** schema.org JSON-LD object (or @graph array) embedded in the document head. */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
	title = 'Blog',
	description = '',
	image,
	siteTitle = 'My Blog',
	markdownHref,
	jsonLd,
} = Astro.props as Props;

const jsonLdScript = jsonLd ? serializeJsonLd(jsonLd) : '';

const resolvedImage = image || (site as any).socialPreviewUrl || '';

const owner = (site as any).owner;
const BASE_URL = import.meta.env.BASE_URL;

const rawHeader: NavItem[] = (nav as any).header || [];
const beforePosts = rawHeader.filter((n) => n.navigationIndex < 0).sort((a, b) => a.navigationIndex - b.navigationIndex);
const afterPosts = rawHeader.filter((n) => n.navigationIndex >= 0).sort((a, b) => a.navigationIndex - b.navigationIndex);
const headerNav: NavItem[] = [...beforePosts, { title: 'Posts', slug: '', navigationIndex: 0 }, ...afterPosts];

const footerNav: NavItem[] = [...(nav as any).footer || []].sort((a, b) => a.navigationIndex - b.navigationIndex);

interface SocialLink {
	provider: string;
	url: string;
	handle: string;
}

/** Display handle next to social icons (e.g. @vdsabev, or domain for website). */
function socialHandle(provider: string, url: string): string {
	const key = (provider || '').toLowerCase();
	try {
		const u = new URL(url);
		const host = u.hostname.replace(/^www\./i, '');
		const parts = u.pathname.replace(/\/+$/, '').split('/').filter(Boolean);

		if (key === 'website' || key === 'generic') {
			return host || url;
		}

		// Mastodon: instance.example/@user or /@user
		if (key === 'mastodon') {
			const at = parts.find((p) => p.startsWith('@'));
			if (at) return at;
			if (parts[0]) return parts[0].startsWith('@') ? parts[0] : `@${parts[0]}`;
		}

		// LinkedIn: /in/username or /company/name — no leading @ (product choice)
		if (key === 'linkedin') {
			const handle = parts[parts[0] === 'in' || parts[0] === 'company' ? 1 : 0];
			if (handle) return handle;
		}

		// Bluesky: /profile/handle.bsky.social
		if (key === 'bluesky') {
			const handle = parts[0] === 'profile' ? parts[1] : parts[0];
			if (handle) return handle.startsWith('@') ? handle : `@${handle}`;
		}

		// YouTube: /@user, /c/name, /channel/id, /user/name
		if (key === 'youtube') {
			if (parts[0]?.startsWith('@')) return parts[0];
			if ((parts[0] === 'c' || parts[0] === 'user' || parts[0] === 'channel') && parts[1]) {
				return parts[1].startsWith('@') ? parts[1] : `@${parts[1]}`;
			}
			if (parts[0]) return parts[0].startsWith('@') ? parts[0] : `@${parts[0]}`;
		}

		// X, Instagram, Twitch, Reddit, Stack Overflow, Facebook, etc.: last meaningful path segment
		let segment = parts[parts.length - 1] || '';
		// Reddit: /user/name or /u/name
		if (key === 'reddit' && (parts[0] === 'user' || parts[0] === 'u') && parts[1]) {
			segment = parts[1];
		}
		// Stack Overflow: /users/id/name → prefer name
		if (key === 'stackoverflow' && parts[0] === 'users' && parts.length >= 3) {
			segment = parts[2];
		}
		if (!segment) return host || url;
		segment = decodeURIComponent(segment).replace(/^@/, '');
		// Prefer @handle for socials; website (above) and LinkedIn are the exceptions without @.
		return `@${segment}`;
	} catch {
		return url;
	}
}

const rawSocials: { provider: string; url: string }[] = Array.isArray((site as any).socials)
	? (site as any).socials
	: [];

function normalizeSocialUrl(url: string): string {
	return url.replace(/\/+$/, '').toLowerCase();
}

const ownerGithubUrl = owner?.login ? `https://github.com/${owner.login}` : '';
const ownerGithubNorm = ownerGithubUrl ? normalizeSocialUrl(ownerGithubUrl) : '';

// Prepend repo owner GitHub; skip any raw entry that is the same GitHub profile
// (provider github or same normalized URL) so we never show two identical links.
const filteredSocials = rawSocials.filter((link) => {
	const provider = (link.provider || '').toLowerCase();
	if (provider === 'github') return false;
	if (ownerGithubNorm && normalizeSocialUrl(link.url) === ownerGithubNorm) return false;
	return true;
});

const socialItems: SocialLink[] = [
	...(owner?.login
		? [{ provider: 'github', url: ownerGithubUrl, handle: `@${owner.login}` }]
		: []),
	...filteredSocials.map((link) => ({
		provider: link.provider,
		url: link.url,
		handle: socialHandle(link.provider, link.url),
	})),
];
---

<!doctype html>
<html lang="en" class="bg-white p-0 text-slate-900 font-sans leading-relaxed dark:bg-slate-900 dark:text-slate-100">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{owner?.avatarUrl
			? <link rel="icon" type="image/png" href={owner.avatarUrl} />
			: <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		}
		<meta name="generator" content={Astro.generator} />
		<title>{siteTitle} | {title}</title>
		<meta property="og:title" content={`${siteTitle} | ${title}`} />
		<meta property="og:site_name" content={siteTitle} />
		<meta name="twitter:card" content="summary_large_image" />
		{description && <meta name="description" content={description} />}
		{description && <meta property="og:description" content={description} />}
		{description && <meta name="twitter:description" content={description} />}
		{resolvedImage && <meta property="og:image" content={resolvedImage} />}
		{resolvedImage && <meta name="twitter:image" content={resolvedImage} />}
		{markdownHref && (
			<link rel="alternate" type="text/markdown" title="Markdown" href={markdownHref} />
		)}
		<link rel="llms-txt" type="text/plain" title="LLMs" href={`${BASE_URL}llms.txt`} />
		<link rel="alternate" type="text/plain" title="LLMs full text" href={`${BASE_URL}llms-full.txt`} />
		<link rel="stylesheet" href={`${BASE_URL}pagefind/pagefind-component-ui.css`} />
		<script src={`${BASE_URL}pagefind/pagefind-component-ui.js`} type="module"></script>
		{jsonLdScript && (
			<script type="application/ld+json" set:html={jsonLdScript} />
		)}
	</head>

	<body class="flex flex-col max-w-2xl min-h-dvh mx-auto px-4 py-8">
		<header class="flex justify-between items-center gap-2 border-b border-b-slate-200 dark:border-b-slate-700 mb-8 pb-4">
			<a href={import.meta.env.BASE_URL} class="text-2xl font-semibold no-underline text-inherit">
				{siteTitle}
			</a>

			<nav class="flex items-center gap-3">
				{headerNav.map((item) => (
					<NavLink href={`${BASE_URL}${item.slug}${item.slug ? '/' : ''}`} class="whitespace-nowrap">{item.title}</NavLink>
				))}

				<pagefind-modal-trigger
					placeholder="Search"
					shortcut="mod+k"
					hide-shortcut
					compact
				></pagefind-modal-trigger>
			</nav>
		</header>

		<pagefind-config bundle-path={`${BASE_URL}pagefind/`} base-url={BASE_URL}></pagefind-config>
		<pagefind-modal reset-on-close></pagefind-modal>

		<main class="flex-1">
			<slot />
		</main>

		<footer class="flex flex-col items-center gap-2 border-t border-t-slate-200 dark:border-t-slate-700 mt-8 pt-4 text-xs text-slate-500 dark:text-slate-400">
			{socialItems.length > 0 && (
				<nav class="flex flex-wrap justify-center items-center gap-1" aria-label="Social links">
					{socialItems.map((link, i) => (
						<>
							{i > 0 && <span class="text-slate-300 dark:text-slate-600">·</span>}
							<a
								href={link.url}
								target="_blank"
								rel={link.provider === 'github' ? 'author me noopener noreferrer' : 'me noopener noreferrer'}
								class="inline-flex items-center gap-1 text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-100 transition-colors no-underline"
							>
								<SocialIcon provider={link.provider} decorative />
								<span>{link.handle}</span>
							</a>
						</>
					))}
				</nav>
			)}

			<div class="flex flex-wrap justify-center items-baseline gap-1">
				<p>powered by <a href="https://github.com/vdsabev/cmless">cmless</a></p>
				<span class="text-slate-300 dark:text-slate-600">·</span>

				<NavLink href={`${BASE_URL}rss.xml`}>rss</NavLink>

				{footerNav.map((item) => (
					<>
						<span class="text-slate-300 dark:text-slate-600">·</span>
						<NavLink href={`${BASE_URL}${item.slug}/`}>{item.title}</NavLink>
					</>
				))}
			</div>
		</footer>

		{/*
		  List↔post shared elements: post page uses .vt-post-* CSS names;
		  list claims the same names on one card (click forward, pagereveal back).
		*/}
		<script is:inline define:vars={{ baseUrl: BASE_URL }}>
			const VT_SLUG_KEY = 'cmless-vt-post-slug';
			const VT_TRANSITIONS = [
				{ selector: '[data-vt-title]', transitionName: 'post-title' },
				{ selector: '[data-vt-meta]', transitionName: 'post-meta' },
				{ selector: '[data-vt-description]', transitionName: 'post-description' },
				{ selector: '[data-vt-tags]', transitionName: 'post-tags' },
				{ selector: '[data-vt-image]', transitionName: 'post-image' },
			];

			function clearVtClaims() {
				const selectors = VT_TRANSITIONS.map((t) => t.selector).join(', ');
				document.querySelectorAll(selectors).forEach((el) => {
					el.style.viewTransitionName = '';
				});
			}

			function claimVtCard(root) {
				if (!(root instanceof Element)) return;
				clearVtClaims();
				for (const { selector, transitionName } of VT_TRANSITIONS) {
					const element = root.querySelector(selector);
					if (element) element.style.viewTransitionName = transitionName;
				}
			}

			function rememberVtSlug(slug) {
				if (!slug) return;
				try {
					sessionStorage.setItem(VT_SLUG_KEY, slug);
				} catch {
					/* private mode / quota */
				}
			}

			function readVtSlug() {
				try {
					return sessionStorage.getItem(VT_SLUG_KEY);
				} catch {
					return null;
				}
			}

			/** Post slug from a same-origin path, or null for index / tags / non-posts. */
			function postSlugFromPathname(pathname) {
				const base = (baseUrl || '/').replace(/\/$/, '') || '';
				let rest = pathname || '';
				if (base && (rest === base || rest.startsWith(base + '/'))) {
					rest = rest.slice(base.length) || '/';
				}
				const parts = rest.split('/').filter(Boolean);
				if (parts.length !== 1) return null;
				const segment = parts[0];
				// Catalog / feed endpoints and any non-HTML twin (*.md, *.xml, *.txt).
				if (
					segment === 'tags' ||
					segment === 'rss.xml' ||
					segment === 'sitemap.xml' ||
					segment === 'robots.txt' ||
					segment === 'llms.txt' ||
					segment === 'index.md' ||
					/\.(md|xml|txt)$/i.test(segment)
				) {
					return null;
				}
				return segment;
			}

			// On a post page, remember slug so list can claim on return (back/nav).
			if (document.querySelector('.vt-post-title')) {
				rememberVtSlug(postSlugFromPathname(location.pathname));
			}

			// List → post: claim the clicked card before navigation snapshots.
			document.addEventListener(
				'click',
				(event) => {
					const link = event.target instanceof Element ? event.target.closest('a[data-vt-card]') : null;
					if (
						!link ||
						event.defaultPrevented ||
						event.button !== 0 ||
						event.metaKey ||
						event.ctrlKey ||
						event.shiftKey ||
						event.altKey
					) {
						return;
					}
					const root = link.closest('[data-vt-card-root]');
					if (!root) return;
					const slug = root.getAttribute('data-slug');
					if (slug) rememberVtSlug(slug);
					claimVtCard(root);
				},
				true,
			);

			// Post → list: claim the matching card once the list is about to paint under VT.
			window.addEventListener('pagereveal', (event) => {
				if (!event.viewTransition) return;
				if (!document.querySelector('[data-vt-card-root]')) return;
				const slug = readVtSlug();
				if (!slug) return;
				const root = document.querySelector(
					`[data-vt-card-root][data-slug="${CSS.escape(slug)}"]`,
				);
				if (root) claimVtCard(root);
			});
		</script>
	</body>
</html>
